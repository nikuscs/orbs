{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "i18n:compile": {
      "outputs": [
        "src/paraglide/**"
      ],
      "inputs": [
        "messages/**",
        "project.inlang/settings.json",
        "scripts/**",
        "src/config.ts",
        "src/entry.vite.ts"
      ]
    },
    "dev": {
      "dependsOn": [
        "@repo/i18n#i18n:compile"
      ],
      "persistent": true,
      "cache": false
    },
    "@repo/web#dev": {
      "with": [
        "@repo/daemon#dev"
      ]
    },
    "dev:macos": {
      "with": [
        "@repo/daemon#dev"
      ],
      "persistent": true,
      "cache": false
    },
    "dev:linux": {
      "with": [
        "@repo/daemon#dev"
      ],
      "persistent": true,
      "cache": false
    },
    "dev:native": {
      "dependsOn": [
        "@repo/i18n#i18n:compile"
      ],
      "persistent": true,
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build",
        "@repo/i18n#i18n:compile"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "start": {
      "persistent": true,
      "cache": false
    },
    "check": {
      "dependsOn": [
        "^check",
        "@repo/i18n#i18n:compile"
      ]
    },
    "lint": {
      "dependsOn": [
        "@repo/i18n#i18n:compile"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../oxlint.config.ts"
      ]
    },
    "lint:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": [
        "@repo/i18n#i18n:compile"
      ],
      "outputs": []
    }
  }
}
