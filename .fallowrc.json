{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    ".agents/sync.ts",
    ".agents/skills/*/scripts/**/*.ts",
    "apps/mobile/app.config.ts",
    "apps/web/src/application/server.tanstack.ts",
    "apps/web/src/application/server.bun.ts",
    "apps/web/src/application/start.ts",
    "apps/web/src/application/routes.ts",
    "apps/web/src/application/router.tsx",
    "apps/web/vite/**/*.ts",
    "scripts/**/*.ts",
    "apps/desktop/src/desktop.ts",
    "apps/desktop/src/views/connect/index.ts",
    "apps/desktop/electrobun.config.ts"
  ],
  "ignorePatterns": [
    "!.agents/**",
    "packages/i18n/src/paraglide/**",
    "**/*.generated.ts",
    "apps/web/src/application/routes.tree.ts"
  ],
  "ignoreDependencies": [
    "oxlint-tsgolint",
    "typescript",
    "turbo",
    "~icons",
    "tailwind-scrollbar",
    "@svgr/core",
    "@svgr/plugin-jsx",
    "@iconify-json/logos",
    "@iconify-json/lucide",
    "@iconify-json/svg-spinners",
    "@iconify-json/vscode-icons",
    "babel-plugin-react-compiler",
    "tailwindcss",
    "@expo-google-fonts/inter",
    "expo-system-ui",
    "babel-preset-expo"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "warn",
    "unused-dependencies": "warn",
    "unused-dev-dependencies": "warn",
    "unresolved-imports": "warn",
    "unlisted-dependencies": "warn",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "stale-suppressions": "warn"
  },
  "workspaces": {
    "patterns": [
      "apps/daemon",
      "apps/mobile",
      "apps/web",
      "packages/*"
    ]
  },
  "ignoreExports": [
    {
      "file": "apps/web/src/components/ui/**",
      "exports": [
        "*"
      ]
    }
  ]
}
