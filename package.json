  "scripts": {
    "postinstall": "bun run --cwd packages/i18n i18n:compile",
    "agents:sync": "bun .agents/sync.ts",
    "dev:all": "turbo run dev --filter=@repo/web --filter=@repo/mobile --log-prefix=none --env-mode=loose",
    "dev:web": "turbo run dev --filter=@repo/web --log-prefix=none --env-mode=loose",
    "dev:mobile": "turbo run dev --filter=@repo/mobile --log-prefix=none --env-mode=loose",
    "dev:mobile:native": "turbo run dev:native --filter=@repo/mobile --log-prefix=none --env-mode=loose",
    "clean": "sh -c 'set -eu; rm -rf .local logs coverage playwright-report test-results .cache apps/mobile/ios apps/mobile/android \"${TMPDIR:-/tmp}\"/metro-* \"${TMPDIR:-/tmp}\"/haste-* \"$HOME\"/Library/Developer/Xcode/DerivedData/OrbsDev-*; watchman watch-del-all >/dev/null 2>&1 || true; for root in packages apps .; do [ -d \"$root\" ] || continue; for name in node_modules .turbo dist build .output .nitro .tanstack .vite .expo .content-collections .bundle-stats coverage playwright-report test-results .cache .fallow; do find \"$root\" -type d -name \"$name\" -prune -exec rm -rf {} +; done; done; find . \\( -name tsconfig.tsbuildinfo -o -name \"*.log\" \\) -delete'",
    "dev:pair": "bun run --cwd apps/daemon dev:pair",
    "dev:desktop": "turbo run dev:app --filter=@repo/desktop --log-prefix=none --env-mode=loose",
    "release:desktop": "bun --env-file=.env scripts/desktop.ts release",
    "release:ios": "bun run --cwd apps/mobile eas:testflight",
    "release:ios-expo": "bun run --cwd apps/mobile eas:testflight:cloud",
    "release": "bun --env-file=.env scripts/release.ts",
    "screenshots:web": "bun scripts/web.ts screenshots",
    "build:web": "turbo run build --filter=@repo/web",
    "start:web": "turbo run start --filter=@repo/web --log-prefix=none --env-mode=loose",
    "start:daemon": "turbo run start --filter=@repo/daemon --log-prefix=none --env-mode=loose",
    "check": "turbo run check",
    "test": "turbo run test",
    "test:ci": "turbo run test -- --bail=1",
    "test:coverage": "vitest run --coverage",
    "lint": "turbo run lint --continue && oxlint scripts -c ./oxlint.config.ts --disable-nested-config && bun run lint:cycles",
    "lint:fix": "turbo run lint:fix --continue && oxlint scripts -c ./oxlint.config.ts --disable-nested-config --fix",
    "lint:cycles": "fallow architecture --cycles --fail-on-issues",
    "lint:dead": "fallow dead-code"
  },
  "trustedDependencies": [
    "react-native-enriched-markdown"
  ]
}
