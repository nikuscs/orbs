# =============================================================================
# ORBS ENV
# Copy to .env. Every value is optional; the defaults build and run Orbs.
# Shell variables win over this file.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Product name shown in the apps, notifications, OAuth screens and bot instructions.
APP_NAME=Orbs
VITE_APP_NAME=Orbs
# Data root for the database, bot stores and logs.
DATA_DIR=~/.config/orbs/
# debug | info | warn | error
LOG_LEVEL=info
# Pi agent directory: provider logins (auth.json), custom endpoints (models.json), skills and instructions. Read by Pi.
# PI_CODING_AGENT_DIR=~/.pi/agent

# -----------------------------------------------------------------------------
# Daemon
# -----------------------------------------------------------------------------
DAEMON_HOST=0.0.0.0
DAEMON_PORT=3000
# Extra browser origins allowed to call the daemon, comma separated.
DAEMON_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Web
# -----------------------------------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=47190
# Origin the pairing link opens; the code inside it carries every daemon address.
WEB_PUBLIC_URL=http://127.0.0.1:47190

# -----------------------------------------------------------------------------
# Mobile (iOS)
# APP_VARIANT (development | preview | production) adds " Dev"/" Preview" to the name,
# "-dev"/"-preview" to the scheme and ".dev"/".preview" to the bundle ID.
# EAS cloud builds do not upload .env: set the same values with `eas env:create`.
# -----------------------------------------------------------------------------
# The notification extension and app group derive from this ID.
MOBILE_BUNDLE_ID=app.openbots.mobile
MOBILE_SCHEME=orbs
# Apple Developer team that signs the app and its notification extension.
MOBILE_APPLE_TEAM_ID=
# Expo account, slug and project ID (from `eas init`); needed for push notifications.
MOBILE_EAS_OWNER=
MOBILE_EAS_SLUG=orbs
MOBILE_EAS_PROJECT_ID=

# -----------------------------------------------------------------------------
# Desktop (macOS)
# -----------------------------------------------------------------------------
DESKTOP_BUNDLE_ID=app.orbs.desktop
DESKTOP_VERSION=0.0.0

# -----------------------------------------------------------------------------
# Desktop release (bun run release:desktop)
# -----------------------------------------------------------------------------
# Dedicated keychain holding the Developer ID Application certificate.
DESKTOP_SIGNING_KEYCHAIN=
# SHA-1 fingerprint of that certificate.
DESKTOP_SIGNING_IDENTITY=
# Optional when a credentials.json beside the keychain has releaseKeychainPassword, apiKeyId and apiIssuerId.
DESKTOP_SIGNING_KEYCHAIN_PASSWORD=
DESKTOP_NOTARY_KEY_ID=
DESKTOP_NOTARY_ISSUER=
# Defaults to AuthKey_<key id>.p8 beside the keychain.
DESKTOP_NOTARY_KEY_PATH=

# Docker Engine socket for bot computers, as unix:///path/to/docker.sock.
# Defaults to Docker Desktop's socket, then /var/run/docker.sock.
# DOCKER_HOST=
