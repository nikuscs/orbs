# Copy to .env (Bun loads it automatically) and fill in the daemon key from /settings/daemon-key.
ORBS_API_KEY=
# Folder Pi works in. Not a sandbox: bots run Pi's default tools (read, bash, edit, write) as this OS user.
ORBS_WORKDIR=
# Skills and AGENTS.md shared by this organization's bots (each bot opts in). One folder per daemon, since a daemon serves one organization.
ORBS_SHARED_HOME=~/.orbs/shared
# Bot turns this daemon runs at once, across all rooms; the rest wait in the queue.
ORBS_MAX_TURNS=4
