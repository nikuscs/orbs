# Copy to .env and fill in real values to run the app locally. Wrangler (vite dev, wrangler types)
# loads .env when no .dev.vars exists, and Bun (start:bun) loads it on its own.
# Wrangler builds the Env type in worker-configuration.d.ts from your .env keys,
# so every binding the code reads must be listed here or `bun run check` fails.
# Production: copy to .prod.vars and run `bun run secrets:push`.
BETTER_AUTH_SECRET=orbs-local-development-secret-not-for-production
GOOGLE_CLIENT_ID=orbs-local-google-client
GOOGLE_CLIENT_SECRET=orbs-local-google-secret
TYPESAFE_API_KEY=orbs-local-typesafe-key
