{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbs-web",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/application/server.cloudflare.ts",
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_URL": "http://localhost:47101"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orbs-database",
      "migrations_dir": "../server/src/services/database/migrations/core"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TENANT", "class_name": "TenantObject" }]
  },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "orbs-files" }],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkspaceObject"] },
    { "tag": "v2", "renamed_classes": [{ "from": "WorkspaceObject", "to": "TenantObject" }] }
  ],
  "ratelimits": [
    {
      "name": "INGEST_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RPC_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 100, "period": 60 }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
