{
  "name": "@orbs/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:cloudflare": "vite dev --port 47101",
    "dev:bun": "vite build --mode native && bun src/application/server.bun.ts",
    "build:cloudflare": "vite build",
    "build:bun": "vite build --mode native",
    "start:bun": "bun src/application/server.bun.ts",
    "preview:cloudflare": "vite preview --port 47101",
    "deploy:cloudflare": "vite build && bun run secrets:check && wrangler d1 migrations apply orbs-database --remote && wrangler deploy --no-x-provision",
    "deploy:first": "vite build && wrangler d1 migrations apply orbs-database --remote && wrangler deploy --no-x-provision --secrets-file .prod.vars && bun run secrets:check",
    "secrets:push": "wrangler secret bulk .prod.vars",
    "secrets:check": "bun ../../scripts/web-secrets-check.ts",
    "cf-typegen": "wrangler types",
    "check": "wrangler types && tsc --noEmit",
    "lint": "oxlint src/ vite/ -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config",
    "lint:fix": "oxlint src/ vite/ -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config --fix",
    "db:migrate": "wrangler d1 migrations apply orbs-database --local",
    "db:seed": "bun ../../scripts/web-seed-dev.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.211",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@orbs/avatar-blobs": "workspace:*",
    "@orbs/errors": "workspace:*",
    "@orbs/i18n": "workspace:*",
    "@orbs/logger": "workspace:*",
    "@orbs/server": "workspace:*",
    "@orbs/tanstack-helpers": "workspace:*",
    "@orpc/client": "2.0.0-beta.39",
    "@orpc/server": "2.0.0-beta.39",
    "@orpc/tanstack-query": "2.0.0-beta.39",
    "@phosphor-icons/react": "^2.1.10",
    "@shadcn/react": "0.3.1",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.58",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-document": "3.31.4",
    "@tiptap/extension-mention": "3.31.4",
    "@tiptap/extension-paragraph": "3.31.4",
    "@tiptap/extension-text": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "ai": "^6.0.209",
    "better-auth": "1.7.6",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "cookie-es": "^3.1.1",
    "cva": "^1.0.0-beta.4",
    "evlog": "^2.29.0",
    "frimousse": "0.3.0",
    "motion": "^12.41.0",
    "radix-ui": "^1.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.80.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "ts-pattern": "^5.6.0",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "5.1.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@cloudflare/vite-plugin": "^1.60.1",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/lucide": "^1.2.114",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@orbs/typescript-config": "workspace:*",
    "@rolldown/plugin-babel": "^0.2.4",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/virtual-file-routes": "^1.162.0",
    "@types/bun": "1.4.2",
    "@types/mdast": "4.0.4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^7.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.1",
    "wrangler": "^4.140.0"
  }
}
