{
  "name": "@repo/mobile",
  "version": "0.1.3",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "scripts": {
    "dev": "lsof -ti tcp:8081 | xargs kill -9 2>/dev/null; { UDID=$(xcrun simctl list devices available | grep 'iPhone Air (' | head -1 | grep -oE '[0-9A-F-]{36}') && xcrun simctl boot \"$UDID\" 2>/dev/null; defaults write com.apple.iphonesimulator CurrentDeviceUDID \"$UDID\"; open \"$(xcode-select -p)/../Applications/DeviceHub.app\" 2>/dev/null || open -a Simulator; } && APP_VARIANT=development bun ../../scripts/mobile.ts",
    "dev:native": "lsof -ti tcp:8081 | xargs kill -9 2>/dev/null; { UDID=$(xcrun simctl list devices available | grep 'iPhone Air (' | head -1 | grep -oE '[0-9A-F-]{36}') && xcrun simctl boot \"$UDID\" 2>/dev/null; defaults write com.apple.iphonesimulator CurrentDeviceUDID \"$UDID\"; open \"$(xcode-select -p)/../Applications/DeviceHub.app\" 2>/dev/null || open -a Simulator; } && APP_VARIANT=development expo run:ios",
    "ios": "APP_VARIANT=development expo run:ios",
    "android": "APP_VARIANT=development expo run:android",
    "eas:dev": "eas build --profile development",
    "eas:preview": "eas build --profile preview",
    "eas:prod": "eas build --profile production",
    "eas:testflight": "PATH=/usr/bin:$PATH eas build --platform ios --profile production --local --output /tmp/orbs-ios.ipa && APP_VARIANT=production eas submit --platform ios --profile production --path /tmp/orbs-ios.ipa",
    "eas:testflight:cloud": "eas build --platform ios --profile production --auto-submit",
    "codegen": "uniwind generate-artifacts --css ./src/application/styles.css --dts ./src/uniwind-types.d.ts",
    "check": "bun run codegen && tsrs --noEmit",
    "lint": "bun run codegen && oxlint src/ app.config.ts -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config",
    "lint:fix": "bun run codegen && oxlint src/ app.config.ts -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config --fix"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "catalog:mobile",
    "@expo/ui": "catalog:mobile",
    "@hookform/resolvers": "catalog:",
    "@json-render/core": "catalog:",
    "@json-render/react-native": "catalog:mobile",
    "@legendapp/list": "catalog:mobile",
    "@repo/avatar-blobs": "workspace:*",
    "@repo/client": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/errors": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@tanstack/react-query": "catalog:",
    "cn": "catalog:",
    "cva": "catalog:",
    "expo": "catalog:mobile",
    "expo-audio": "catalog:mobile",
    "expo-camera": "catalog:mobile",
    "expo-clipboard": "catalog:mobile",
    "expo-constants": "catalog:mobile",
    "expo-device": "catalog:mobile",
    "expo-document-picker": "catalog:mobile",
    "expo-font": "catalog:mobile",
    "expo-glass-effect": "catalog:mobile",
    "expo-image-picker": "catalog:mobile",
    "expo-notifications": "catalog:mobile",
    "expo-web-browser": "catalog:mobile",
    "expo-linear-gradient": "catalog:mobile",
    "expo-linking": "catalog:mobile",
    "expo-router": "catalog:mobile",
    "expo-secure-store": "catalog:mobile",
    "expo-system-ui": "catalog:mobile",
    "expo-video": "catalog:mobile",
    "input-otp-native": "catalog:mobile",
    "katex": "catalog:mobile",
    "lucide-react-native": "catalog:mobile",
    "react": "catalog:",
    "react-hook-form": "catalog:",
    "react-native": "catalog:mobile",
    "react-native-enriched-markdown": "catalog:mobile",
    "react-native-keyboard-controller": "catalog:mobile",
    "react-native-reanimated": "catalog:mobile",
    "react-native-safe-area-context": "catalog:mobile",
    "react-native-screens": "catalog:mobile",
    "react-native-svg": "catalog:mobile",
    "react-native-webview": "catalog:mobile",
    "react-native-worklets": "catalog:mobile",
    "tailwindcss": "catalog:",
    "ts-pattern": "catalog:",
    "uniwind": "catalog:mobile",
    "zod": "catalog:",
    "@pierrecapo/expo-notification-service-extension": "catalog:mobile"
  },
  "devDependencies": {
    "@babel/plugin-transform-parameters": "catalog:mobile",
    "@types/react": "catalog:",
    "babel-preset-expo": "catalog:mobile",
    "typescript": "catalog:"
  },
  "enriched-markdown": {
    "enableMath": false,
    "enableVideo": false
  }
}
