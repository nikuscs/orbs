{
  "name": "@orbs/env",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./daemon": {
      "types": "./src/entry.daemon.ts",
      "default": "./src/entry.daemon.ts"
    },
    "./server": {
      "types": "./src/entry.server.ts",
      "default": "./src/entry.server.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint src/ -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config",
    "lint:fix": "oxlint src/ -c ../../oxlint.config.ts --tsconfig tsconfig.json --disable-nested-config --fix"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@orbs/typescript-config": "workspace:*",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
